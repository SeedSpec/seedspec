{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/experiments/capabilities/0.4/capability-bundle.schema.json",
  "title": "SeedSpec experimental capability bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_bundle_version", "package", "authorship", "capabilities"],
  "properties": {
    "capability_bundle_version": { "const": "0.4-experimental" },
    "package": { "$ref": "#/$defs/packageBinding" },
    "authorship": { "$ref": "#/$defs/authorship" },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authorship": {
            "properties": { "status": { "const": "accepted" } },
            "required": ["status"]
          }
        }
      },
      "then": { "required": ["bundle_digest"] },
      "else": { "not": { "required": ["bundle_digest"] } }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "namespacedId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9-]*){2,}$"
    },
    "localId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "packageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authorship": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "proposed" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "accepted_by", "accepted_at"],
          "properties": {
            "status": { "const": "accepted" },
            "accepted_by": { "type": "string", "minLength": 1, "maxLength": 200 },
            "accepted_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^#[a-f0-9]{12}$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stability"],
      "properties": {
        "kind": { "enum": ["script", "agent-review", "human-observation"] },
        "stability": { "enum": ["deterministic", "nondeterministic"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "runner": { "$ref": "#/$defs/namespacedId" },
        "rubric": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "script" } }, "required": ["kind"] },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "kind": { "const": "agent-review" } }, "required": ["kind"] },
          "then": { "required": ["rubric"] }
        }
      ]
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "source_refs", "acceptance"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/acceptanceCheck" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offers": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        },
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "name", "description", "source_refs", "outcomes"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        },
        "integration": { "$ref": "#/$defs/integration" }
      }
    }
  }
}
