{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/experiments/capabilities/0.4/capability-composition.schema.json",
  "title": "SeedSpec experimental capability composition map",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_composition_version", "bundles", "connections"],
  "properties": {
    "capability_composition_version": { "const": "0.4-experimental" },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "bundle_digest"],
        "properties": {
          "package": { "$ref": "#/$defs/namespacedId" },
          "bundle_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need", "offer", "rationale"],
        "properties": {
          "need": { "$ref": "#/$defs/endpoint" },
          "offer": { "$ref": "#/$defs/endpoint" },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9-]*){2,}$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "edge"],
      "properties": {
        "capability": { "$ref": "#/$defs/namespacedId" },
        "edge": { "$ref": "#/$defs/localId" }
      }
    }
  }
}
