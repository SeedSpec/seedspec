{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/schemas/authoring/v1/authoring-probe-brief.schema.json",
  "title": "SeedSpec frozen clarification probe brief",
  "description": "A content-addressed, source-bound clarification request prepared before any model call.",
  "type": "object",
  "required": [
    "id",
    "digest",
    "authoring_probe_brief_version",
    "prepared_at",
    "purpose",
    "mode",
    "instruction",
    "policy",
    "subject",
    "visibility",
    "execution",
    "budget",
    "artifacts",
    "retention",
    "preflight"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^probe-[0-9a-f]{24}$" },
    "digest": { "$ref": "#/$defs/digest" },
    "authoring_probe_brief_version": { "const": "1" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "purpose": { "const": "clarification" },
    "mode": { "const": "single-interpretation" },
    "instruction": { "$ref": "#/$defs/versionedIdentity" },
    "policy": { "$ref": "#/$defs/versionedIdentity" },
    "subject": {
      "type": "object",
      "required": ["package", "workspace", "pass"],
      "properties": {
        "package": {
          "type": "object",
          "required": ["id", "version", "kind", "digest", "draft_digest"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" },
            "draft_digest": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        "workspace": {
          "type": "object",
          "required": ["id", "revision"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "revision": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        "pass": {
          "type": "object",
          "required": ["id", "area", "target"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "area": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "visibility": {
      "type": "object",
      "required": [
        "manifest_version",
        "included",
        "excluded",
        "review_lenses",
        "no_authoritative_material_silently_truncated"
      ],
      "properties": {
        "manifest_version": { "const": "1" },
        "included": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/includedMaterial" }
        },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/$defs/excludedMaterial" }
        },
        "review_lenses": {
          "type": "array",
          "const": ["seed", "coherence", "success", "supporting-material"]
        },
        "no_authoritative_material_silently_truncated": { "const": true }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["model", "runner", "settings", "permitted_tools", "external_verifier"],
      "properties": {
        "model": {
          "type": "object",
          "required": ["provider", "id"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "runner": {
          "type": "object",
          "required": ["id", "version", "enforces_output_token_limit", "enforces_spend_limit"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "enforces_output_token_limit": { "type": "boolean" },
            "enforces_spend_limit": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "settings": { "type": "object" },
        "permitted_tools": { "type": "array", "maxItems": 0 },
        "external_verifier": { "type": "null" }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "limits",
        "phases",
        "estimated_input",
        "reserved_output_tokens",
        "projected_maximum_usd",
        "pricing",
        "known_omissions"
      ],
      "properties": {
        "limits": { "$ref": "#/$defs/limits" },
        "phases": {
          "type": "object",
          "required": ["generation_attempts", "repetitions", "branches", "retries", "evaluators"],
          "properties": {
            "generation_attempts": { "const": 1 },
            "repetitions": { "const": 1 },
            "branches": { "const": 1 },
            "retries": { "const": 0 },
            "evaluators": { "const": 0 }
          },
          "additionalProperties": false
        },
        "estimated_input": {
          "type": "object",
          "required": ["method", "material_tokens", "fixed_runner_overhead_tokens", "maximum_tokens"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "material_tokens": { "type": "integer", "minimum": 0 },
            "fixed_runner_overhead_tokens": { "type": "integer", "minimum": 0 },
            "maximum_tokens": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "reserved_output_tokens": { "type": "integer", "minimum": 1 },
        "projected_maximum_usd": { "type": "number", "minimum": 0 },
        "pricing": { "$ref": "#/$defs/pricing" },
        "known_omissions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["instructions", "input", "output_schema"],
      "properties": {
        "instructions": { "$ref": "#/$defs/artifact" },
        "input": { "$ref": "#/$defs/artifact" },
        "output_schema": { "$ref": "#/$defs/artifact" },
        "validation_schema": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["classification", "raw_response", "provider_events", "portable_package", "first_party_telemetry"],
      "properties": {
        "classification": { "const": "local-authoring" },
        "raw_response": { "const": "retained-locally" },
        "provider_events": { "const": "retained-locally-with-hidden-reasoning-removed" },
        "portable_package": { "const": "excluded" },
        "first_party_telemetry": { "const": "excluded" }
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "required": ["checked_at", "status", "checks", "degraded"],
      "properties": {
        "checked_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["ready", "blocked"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "degraded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "versionedIdentity": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "includedMaterial": {
      "type": "object",
      "required": ["id", "kind", "authority", "path", "media_type", "digest", "bytes", "estimated_tokens"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "path": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "media_type": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "excludedMaterial": {
      "type": "object",
      "required": ["id", "kind", "authority", "digest", "bytes", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "digest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["model_context_tokens", "max_input_tokens", "max_output_tokens", "max_attempts", "max_retries", "max_duration_ms", "max_spend_usd"],
      "properties": {
        "model_context_tokens": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_attempts": { "const": 1 },
        "max_retries": { "const": 0 },
        "max_duration_ms": { "type": "integer", "minimum": 1 },
        "max_spend_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "required": ["currency", "basis", "input_per_million_usd", "output_per_million_usd", "source", "observed_at"],
      "properties": {
        "currency": { "const": "USD" },
        "basis": { "enum": ["provider-billed", "subscription-list-price-equivalent"] },
        "input_per_million_usd": { "type": "number", "minimum": 0 },
        "output_per_million_usd": { "type": "number", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["file", "digest", "bytes"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
