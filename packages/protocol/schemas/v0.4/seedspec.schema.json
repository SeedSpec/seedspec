{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/releases/0.4.1/schemas/seedspec.schema.json",
  "title": "SeedSpec Protocol 0.4 package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "kind": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "target_protocol": { "const": "0.4" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "configuration": { "$ref": "#/$defs/configurationSubject" },
    "success": { "$ref": "#/$defs/successSubject" },
    "tasks": { "$ref": "#/$defs/taskSubject" },
    "capabilities": { "$ref": "#/$defs/capabilitySubject" },
    "context_modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextModule" }
    },
    "bundled_packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundledPackage" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/namespacedIdentifier" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+(?:-?[a-z0-9]+)*)*$"
    },
    "namespacedIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+(?:-?[a-z0-9]+)*)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": { "$ref": "#/$defs/nonEmptyString" },
        "homepage": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" },
        "documentation": { "type": "string", "format": "uri" }
      }
    },
    "sectionBase": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "configurationItemType": {
      "enum": ["string", "integer", "number", "boolean"]
    },
    "configurationVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["string", "integer", "number", "boolean", "array"] },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean", "default": false },
        "default": true,
        "example": true,
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": true
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "$ref": "#/$defs/configurationItemType" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "array" } },
            "required": ["type"]
          },
          "then": { "required": ["items"] },
          "else": { "not": { "required": ["items"] } }
        }
      ]
    },
    "successCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instruction"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "instruction": { "$ref": "#/$defs/nonEmptyString" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "capabilityOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityOutcome" }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "configurationSection": {
      "allOf": [
        { "$ref": "#/$defs/sectionBase" },
        {
          "type": "object",
          "properties": {
            "variables": {
              "type": "array",
              "items": { "$ref": "#/$defs/configurationVariable" }
            },
            "path": { "$ref": "#/$defs/packagePath" }
          },
          "oneOf": [
            { "required": ["variables"], "not": { "required": ["path"] } },
            { "required": ["path"], "not": { "required": ["variables"] } }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "successSection": {
      "allOf": [
        { "$ref": "#/$defs/sectionBase" },
        {
          "type": "object",
          "properties": {
            "criteria": {
              "type": "array",
              "items": { "$ref": "#/$defs/successCriterion" }
            },
            "path": { "$ref": "#/$defs/packagePath" }
          },
          "oneOf": [
            { "required": ["criteria"], "not": { "required": ["path"] } },
            { "required": ["path"], "not": { "required": ["criteria"] } }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "taskSection": {
      "allOf": [
        { "$ref": "#/$defs/sectionBase" },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/task" }
            },
            "path": { "$ref": "#/$defs/packagePath" }
          },
          "oneOf": [
            { "required": ["items"], "not": { "required": ["path"] } },
            { "required": ["path"], "not": { "required": ["items"] } }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilitySection": {
      "allOf": [
        { "$ref": "#/$defs/sectionBase" },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/capability" }
            },
            "path": { "$ref": "#/$defs/packagePath" }
          },
          "oneOf": [
            { "required": ["items"], "not": { "required": ["path"] } },
            { "required": ["path"], "not": { "required": ["items"] } }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "configurationSubject": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["variables"], "not": { "required": ["sections"] } },
        { "required": ["sections"], "not": { "required": ["variables"] } }
      ],
      "properties": {
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/configurationVariable" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/configurationSection" }
        }
      }
    },
    "successSubject": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["criteria"], "not": { "required": ["sections"] } },
        { "required": ["sections"], "not": { "required": ["criteria"] } }
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/successCriterion" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/successSection" }
        }
      }
    },
    "taskSubject": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["items"], "not": { "required": ["sections"] } },
        { "required": ["sections"], "not": { "required": ["items"] } }
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskSection" }
        }
      }
    },
    "capabilitySubject": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["items"], "not": { "required": ["sections"] } },
        { "required": ["sections"], "not": { "required": ["items"] } }
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilitySection" }
        }
      }
    },
    "contextModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": {
          "enum": [
            "intent",
            "skill",
            "behavior",
            "evaluation",
            "policy",
            "reference",
            "implementation-profile"
          ]
        },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/packagePath" },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/nonEmptyString" },
            "path": { "$ref": "#/$defs/packagePath" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "authoring",
                  "composition",
                  "implementation",
                  "verification",
                  "operation"
                ]
              }
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "success_criteria": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            }
          },
          "minProperties": 1
        }
      }
    },
    "bundledPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "path": { "$ref": "#/$defs/packagePath" },
        "optional": { "type": "boolean", "default": false }
      }
    }
  }
}
