{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/releases/0.4.0/schemas/conformance.schema.json",
  "title": "SeedSpec Protocol 0.4 conformance suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "protocol_version", "cases"],
  "properties": {
    "suite_version": { "const": "0.4.0" },
    "protocol_version": { "const": "0.4" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "package", "expect"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["validate", "digest-stability"] },
          "package": { "type": "string", "minLength": 1 },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result"],
            "properties": {
              "result": { "enum": ["pass", "fail"] },
              "code": { "type": "string", "minLength": 2 },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "allOf": [
              {
                "if": { "properties": { "result": { "const": "fail" } }, "required": ["result"] },
                "then": { "required": ["code"] }
              }
            ]
          }
        }
      }
    }
  }
}
