{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/private/authoring-evals/run-contract.schema.json",
  "title": "SeedSpec authoring evaluation run contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authoring_eval_run_contract_version",
    "run_id",
    "created_at",
    "subject",
    "authoring",
    "execution",
    "cli",
    "workspace",
    "budget",
    "retention",
    "snapshots",
    "contract_id"
  ],
  "properties": {
    "authoring_eval_run_contract_version": { "const": "1" },
    "run_id": { "type": "string", "pattern": "^run-[0-9a-f-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "contract_id": { "type": "string", "pattern": "^run-contract-[a-f0-9]{64}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "format_version": { "const": "1" }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "prompt", "handoff"],
      "properties": {
        "mode": { "enum": ["minimal", "shape", "deep"] },
        "prompt": { "type": "string", "minLength": 1 },
        "handoff": { "$ref": "#/$defs/fileReference" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "model", "settings", "tools", "network"],
      "properties": {
        "runner": { "$ref": "#/$defs/identity" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id", "selector"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "selector": { "type": "string", "minLength": 1 }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reasoning_effort"],
          "properties": {
            "reasoning_effort": { "type": "string", "minLength": 1 }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "network": { "enum": ["disabled", "enabled", "runner-default"] }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "protocol_release",
        "executable",
        "source_root",
        "source_commit",
        "source_dirty"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "protocol_release": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "source_root": { "type": "string", "minLength": 1 },
        "source_commit": { "type": ["string", "null"] },
        "source_dirty": { "type": ["boolean", "null"] }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "package", "state", "sources"],
      "properties": {
        "root": { "$ref": "#/$defs/relativePath" },
        "package": { "$ref": "#/$defs/relativePath" },
        "state": { "$ref": "#/$defs/relativePath" },
        "sources": { "$ref": "#/$defs/relativePath" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_ms",
        "max_turns",
        "max_spend_usd",
        "max_input_tokens",
        "max_output_tokens",
        "on_limit"
      ],
      "properties": {
        "max_duration_ms": { "type": "integer", "minimum": 1 },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_spend_usd": { "$ref": "#/$defs/nullableLimit" },
        "max_input_tokens": { "$ref": "#/$defs/nullableLimit" },
        "max_output_tokens": { "$ref": "#/$defs/nullableLimit" },
        "on_limit": { "const": "stop" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "retain",
        "hidden_reasoning",
        "secrets",
        "failure_evidence",
        "expires_at"
      ],
      "properties": {
        "class": { "type": "string", "minLength": 1 },
        "retain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "hidden_reasoning": { "const": "exclude" },
        "secrets": { "const": "redact" },
        "failure_evidence": { "const": "retain" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "cli_source", "starter_package", "initial_authoring_state"],
      "properties": {
        "subject": { "$ref": "#/$defs/snapshotReference" },
        "cli_source": { "$ref": "#/$defs/snapshotReference" },
        "starter_package": { "$ref": "#/$defs/snapshotReference" },
        "initial_authoring_state": { "$ref": "#/$defs/snapshotReference" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nullableLimit": { "type": ["number", "null"], "minimum": 0 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "snapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "files", "bytes", "exclude", "manifest"],
      "properties": {
        "algorithm": { "const": "seedspec-authoring-eval-tree-sha256-v1" },
        "digest": { "$ref": "#/$defs/digest" },
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "manifest": { "$ref": "#/$defs/fileReference" }
      }
    }
  }
}
