{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/private/authoring-evals/comparison.schema.json",
  "title": "SeedSpec authoring evaluation comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authoring_eval_comparison_version",
    "comparison_mode",
    "subject",
    "identity",
    "runs",
    "claims",
    "limitations"
  ],
  "properties": {
    "authoring_eval_comparison_version": { "const": "1" },
    "comparison_mode": { "const": "descriptive-confounded" },
    "subject": { "type": "string", "minLength": 1 },
    "identity": { "type": "object" },
    "runs": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winner", "causal_model_effect", "causal_runner_effect"],
      "properties": {
        "winner": { "type": "null" },
        "causal_model_effect": { "const": false },
        "causal_runner_effect": { "const": false }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
