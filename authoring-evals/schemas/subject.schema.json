{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/private/authoring-evals/subject.schema.json",
  "title": "SeedSpec authoring evaluation subject",
  "oneOf": [
    { "$ref": "#/$defs/subjectV1" },
    { "$ref": "#/$defs/subjectV2" }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "authority"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/relativePath" },
        "authority": { "type": "string", "minLength": 1 }
      }
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "sources"],
      "properties": {
        "package": { "$ref": "#/$defs/relativePath" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "documentExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "contains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "contains_any": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "excludes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stateExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_complete", "questions", "candidates", "proposals"],
      "properties": {
        "review_complete": { "type": "boolean" },
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "open": { "type": "integer", "minimum": 0 },
            "resolved": { "type": "integer", "minimum": 0 }
          }
        },
        "candidates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "open": { "type": "integer", "minimum": 0 },
            "accepted": { "type": "integer", "minimum": 0 },
            "declined": { "type": "integer", "minimum": 0 }
          }
        },
        "proposals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_paths"],
          "properties": {
            "applied": { "type": "integer", "minimum": 0 },
            "paths": {
              "type": "array",
              "items": { "$ref": "#/$defs/relativePath" }
            },
            "required_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/relativePath" }
            }
          }
        }
      }
    },
    "expectationsV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "documents": {
          "deprecated": true,
          "description": "Historical lexical diagnostics. Version 2 evaluation does not use these as quality gates.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/documentExpectation" }
        },
        "state": { "$ref": "#/$defs/stateExpectations" }
      }
    },
    "proxyDecisionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "answer"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 2 }
            }
          }
        },
        "answer": { "type": "string", "minLength": 1 }
      }
    },
    "authoringPosture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambition", "audience", "handoff", "collaboration"],
      "properties": {
        "ambition": { "enum": ["small", "bounded", "broad"] },
        "audience": { "enum": ["close-internal", "fresh-internal", "external"] },
        "handoff": { "enum": ["exploration", "planning", "implementation-start"] },
        "collaboration": { "enum": ["brief", "standard", "intensive"] }
      }
    },
    "fixedClaimContract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "description", "targets"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "source": { "$ref": "#/$defs/relativePath" },
          "description": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "path", "pointer", "expected"],
              "properties": {
                "format": { "enum": ["json", "yaml"] },
                "path": { "$ref": "#/$defs/relativePath" },
                "pointer": { "type": "string", "pattern": "^/(?:[^/]+/?)*$" },
                "expected": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "boolean" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "decisions",
        "obligations",
        "permitted_variability",
        "forbidden_inventions",
        "protected_paths"
      ],
      "properties": {
        "meaning": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "source", "authority", "materiality", "expectation"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "description": { "type": "string", "minLength": 1 },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": { "path": { "$ref": "#/$defs/relativePath" } }
              },
              "authority": { "type": "string", "minLength": 1 },
              "materiality": { "enum": ["critical", "material", "minor"] },
              "expectation": { "enum": ["preserve", "exclude", "resolve", "delegate"] }
            }
          }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "materiality", "expected_latitude", "acceptable_outcomes"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "description": { "type": "string", "minLength": 1 },
              "materiality": { "enum": ["critical", "material", "minor"] },
              "expected_latitude": { "enum": ["fixed", "preferred", "delegated", "open", "unresolved"] },
              "acceptable_outcomes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "description", "importance"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "kind": { "enum": ["outcome", "behavior", "invariant", "constraint", "forbidden-state", "boundary", "success-criterion"] },
              "description": { "type": "string", "minLength": 1 },
              "importance": { "enum": ["critical", "material", "minor"] }
            }
          }
        },
        "permitted_variability": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "bounds"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "description": { "type": "string", "minLength": 1 },
              "bounds": { "type": "string", "minLength": 1 }
            }
          }
        },
        "forbidden_inventions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "severity"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "description": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["minor", "major", "critical"] }
            }
          }
        },
        "protected_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "kind": { "enum": ["context-module", "skill", "supporting-material"] }
            }
          }
        }
      }
    },
    "subjectV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_eval_subject_version",
        "id",
        "corpus_role",
        "description",
        "mode",
        "starter",
        "author_prompt",
        "execution",
        "proxy_author",
        "reference",
        "expectations"
      ],
      "properties": {
        "authoring_eval_subject_version": { "const": "2" },
        "id": { "$ref": "#/$defs/identifier" },
        "corpus_role": {
          "enum": [
            "sparse-product-idea",
            "mature-requirements",
            "controlled-revision",
            "fixed-context-modules",
            "fresh-context-recovery",
            "composition-conflict"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["minimal", "shape", "deep"] },
        "authoring_posture": { "$ref": "#/$defs/authoringPosture" },
        "fixed_claim_contract": { "$ref": "#/$defs/fixedClaimContract" },
        "starter": { "$ref": "#/$defs/starter" },
        "author_prompt": { "type": "string", "minLength": 1 },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fresh_agent_turns"],
          "properties": {
            "fresh_agent_turns": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 2 }
            }
          }
        },
        "proxy_author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decisions"],
          "properties": {
            "decisions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/proxyDecisionV2" }
            }
          }
        },
        "reference": { "$ref": "#/$defs/reference" },
        "expectations": { "$ref": "#/$defs/expectationsV2" }
      }
    },
    "subjectV1": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "authoring_eval_subject_version",
        "id",
        "description",
        "mode",
        "starter",
        "author_prompt",
        "proxy_author",
        "expectations"
      ],
      "properties": {
        "authoring_eval_subject_version": { "const": "1" },
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["minimal", "shape", "deep"] },
        "starter": { "$ref": "#/$defs/starter" },
        "author_prompt": { "type": "string", "minLength": 1 },
        "proxy_author": { "type": "object" },
        "expectations": { "type": "object" }
      }
    }
  }
}
