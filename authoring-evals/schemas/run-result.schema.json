{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/private/authoring-evals/run-result.schema.json",
  "title": "SeedSpec authoring evaluation run result",
  "type": "object",
  "required": [
    "authoring_eval_run_result_version",
    "contract_id",
    "run_id",
    "execution",
    "evidence",
    "final_snapshots",
    "evaluation_report",
    "outcome",
    "assessment",
    "limitations",
    "quarantine_reasons",
    "run_result_id"
  ],
  "properties": {
    "authoring_eval_run_result_version": { "const": "1" },
    "contract_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "execution": { "type": "object" },
    "evidence": { "type": "object" },
    "final_snapshots": { "type": "object" },
    "evaluation_report": { "type": ["object", "null"] },
    "outcome": { "enum": ["completed", "quarantined"] },
    "assessment": { "enum": ["passed", "failed", "not-run"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "quarantine_reasons": { "type": "array", "items": { "type": "string" } },
    "run_result_id": { "type": "string", "pattern": "^run-result-[a-f0-9]{64}$" }
  }
}
