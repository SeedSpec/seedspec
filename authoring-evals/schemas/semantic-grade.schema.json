{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/private/authoring-evals/semantic-grade.schema.json",
  "title": "SeedSpec authoring semantic grade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semantic_grade_version",
    "grade_id",
    "evidence_id",
    "subject",
    "cli_baseline",
    "evaluator_id",
    "dimensions",
    "reference_assessments",
    "summary",
    "reference_summary",
    "limitations"
  ],
  "properties": {
    "semantic_grade_version": { "const": "1" },
    "grade_id": { "type": "string", "pattern": "^semantic-grade-[a-f0-9]{64}$" },
    "evidence_id": { "type": "string", "pattern": "^semantic-grade-evidence-[a-f0-9]{64}$" },
    "subject": { "$ref": "#/$defs/subjectIdentity" },
    "cli_baseline": { "$ref": "#/$defs/cliBaseline" },
    "evaluator_id": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "$ref": "#/$defs/semanticFidelity" },
        { "$ref": "#/$defs/inventedObligations" },
        { "$ref": "#/$defs/missedConsequentialDecisions" },
        { "$ref": "#/$defs/unnecessaryQuestionBurden" },
        { "$ref": "#/$defs/implementationLatitude" },
        { "$ref": "#/$defs/internalConsistency" },
        { "$ref": "#/$defs/packagingReadiness" },
        { "$ref": "#/$defs/freshAgentUsefulness" }
      ],
      "items": false
    },
    "reference_assessments": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceAssessment" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_score", "maximum_score", "mean_score"],
      "properties": {
        "total_score": { "type": "integer", "minimum": 0, "maximum": 32 },
        "maximum_score": { "const": 32 },
        "mean_score": { "type": "number", "minimum": 0, "maximum": 4 }
      }
    },
    "reference_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_count",
        "aligned_count",
        "within_permitted_variation_count",
        "divergent_count",
        "critical_divergences",
        "permitted_variability_respected"
      ],
      "properties": {
        "axis_count": { "type": "integer", "minimum": 0 },
        "aligned_count": { "type": "integer", "minimum": 0 },
        "within_permitted_variation_count": { "type": "integer", "minimum": 0 },
        "divergent_count": { "type": "integer", "minimum": 0 },
        "critical_divergences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "permitted_variability_respected": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "subjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format_version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "format_version": { "const": "2" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "cliBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "protocol_release", "source_digest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "protocol_release": { "type": "string", "minLength": 1 },
        "source_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "locator", "observation"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 }
      }
    },
    "dimensionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "score", "confidence", "citations", "rationale"],
      "properties": {
        "id": { "type": "string" },
        "score": { "type": "integer", "minimum": 0, "maximum": 4 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "semanticFidelity": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "semantic-fidelity" } } }
      ]
    },
    "inventedObligations": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "invented-obligations" } } }
      ]
    },
    "missedConsequentialDecisions": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "missed-consequential-decisions" } } }
      ]
    },
    "unnecessaryQuestionBurden": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "unnecessary-question-burden" } } }
      ]
    },
    "implementationLatitude": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "implementation-latitude" } } }
      ]
    },
    "internalConsistency": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "internal-consistency" } } }
      ]
    },
    "packagingReadiness": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "packaging-readiness" } } }
      ]
    },
    "freshAgentUsefulness": {
      "allOf": [
        { "$ref": "#/$defs/dimensionBase" },
        { "properties": { "id": { "const": "fresh-agent-usefulness" } } }
      ]
    },
    "referenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_id",
        "reference_kind",
        "reference_id",
        "level",
        "alignment",
        "permitted_variability_respected",
        "confidence",
        "citations",
        "rationale"
      ],
      "properties": {
        "axis_id": { "type": "string", "minLength": 1 },
        "reference_kind": {
          "enum": [
            "meaning",
            "decision",
            "obligation",
            "permitted-variability",
            "forbidden-invention",
            "protected-path"
          ]
        },
        "reference_id": { "type": "string", "minLength": 1 },
        "level": { "enum": ["critical", "material", "minor"] },
        "alignment": { "enum": ["aligned", "within-permitted-variation", "divergent"] },
        "permitted_variability_respected": { "type": "boolean" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
