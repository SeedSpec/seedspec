{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hubspot_object",
    "metric_property",
    "dashboard_name",
    "timezone",
    "delivery_time",
    "slack_channel"
  ],
  "properties": {
    "hubspot_object": {
      "type": "string",
      "const": "deal"
    },
    "metric_property": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "dashboard_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "timezone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "delivery_time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "slack_channel": {
      "type": "string",
      "pattern": "^#[a-z0-9][a-z0-9_-]{0,79}$"
    }
  }
}
